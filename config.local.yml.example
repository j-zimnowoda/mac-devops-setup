---
gitconfig_name: "Your Name"
gitconfig_email: "you@example.com"
gitconfig_signingkey: "YOUR_GPG_KEY_ID"
gitconfig_github_user: "your-github-username"

gpg_key_name: "Your Name"
gpg_key_email: "you@example.com"
gpg_key_passphrase: "change-me"

ssh_key_comment: "you@example.com"
ssh_key_passphrase: "change-me"

github_gpg_key_title: "Mac DevOps GPG Key"
github_ssh_key_title: "Mac DevOps SSH Key"

# Required when configure_github_enterprise_keys is enabled.
github_enterprise_hostname: "github.example.com"
github_enterprise_gpg_key_title: "Mac DevOps GPG Key"
github_enterprise_ssh_key_title: "Mac DevOps SSH Key"
